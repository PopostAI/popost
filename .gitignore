# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
.env
.env.*
!.env.example
.env.local

# Python caches (only the maintainer font tool skills/popost/tools/update_font_library.py is Python)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.playwright-cli/

# Lock files (keep package-lock.json for consistent installs)
yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo

# swc wasm
.swc

# Agent files
.agent/

# npm pack output of the popost CLI
skills/popost/*.tgz

# Template preview images: local input for the publish script only; they are served from the public bucket (AGENTS.md)
skills/popost/templates/community/*/previews/
